-- ฟังก์ชันอัปเดตรายการคำแนะนำตามข้อความที่พิมพ์
local function updateSuggestions(query)
	-- ลบปุ่มเก่าทั้งหมด
	for _, child in pairs(SuggestionScroll:GetChildren()) do
		if child:IsA("TextButton") then child:Destroy() end
	end
	
	if query == "" then
		SuggestionScroll.CanvasSize = UDim2.new(0, 0, 0, 0)
		return
	end
	
	-- ดึงเอาตัวอักษรสุดท้ายของคำมาเทียบ (รองรับการต่อคำพยางค์สุดท้าย)
	-- ตัดช่องว่างออก
	query = query:match("^%s*(.-)%s*$")
	local lastChar = utf8.sub(query, utf8.len(query), utf8.len(query))
	
	local matchedCount = 0
	for _, word in ipairs(ThaiDictionary) do
		-- ตรวจสอบว่าคำในคลังขึ้นต้นด้วยตัวอักษรสุดท้าย หรือตรงกับ query ที่พิมพ์
		if utf8.sub(word, 1, utf8.len(lastChar)) == lastChar or utf8.sub(word, 1, utf8.len(query)) == query then
			matchedCount = matchedCount + 1
			
			local btn = Instance.new("TextButton")
			btn.Size = UDim2.new(1, 0, 0, 30)
			btn.BackgroundColor3 = Color3.fromRGB(35, 42, 58)
			btn.TextColor3 = Color3.fromRGB(255, 255, 255)
			btn.Text = "👉 " .. word
			btn.Font = Enum.Font.SourceSansBold
			btn.TextSize = 14
			btn.TextXAlignment = Enum.TextXAlignment.Left
			btn.Parent = SuggestionScroll
			
			local btnCorner = Instance.new("UICorner")
			btnCorner.CornerRadius = UDim.new(0, 5)
			btnCorner.Parent = btn
			
			-- เมื่อกดที่คำแนะนำ จะนำคำนั้นไปใส่ในช่องพิมพ์ หรือคัดลอกอัตโนมัติ
			btn.MouseButton1Click:Connect(function()
				SearchBox.Text = word
			end)
		end
	end
	
	SuggestionScroll.CanvasSize = UDim2.new(0, 0, 0, matchedCount * 34)
end

-- ตรวจสอบการพิมพ์ข้อความแบบ Real-time
SearchBox:GetPropertyChangedSignal("Text"):Connect(function()
	updateSuggestions(SearchBox.Text)
end)
